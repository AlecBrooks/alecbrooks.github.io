---
layout: base.njk
title: Projects
permalink: /projects/
---
<h1 class="page-title">Projects</h1>
<ul class="project-grid">
  {% for repo in githubRepos %}
    <li class="post project-card">
      <h2><a href="{{ repo.url }}" target="_blank" rel="noopener">{{ repo.name }}</a></h2>
      {% if repo.language %}<span class="badge">{{ repo.language }}</span>{% endif %}
      <p>{{ repo.description or "No description provided." }}</p>
      <p class="meta">Created {{ repo.createdAt | readableDate }} &middot; Updated {{ repo.updatedAt | readableDate }}</p>
    </li>
  {% else %}
    <li class="post">No public repos found (or the GitHub API pull failed at build time).</li>
  {% endfor %}
</ul>

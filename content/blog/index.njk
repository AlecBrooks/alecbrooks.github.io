---
layout: base.njk
title: Blog
permalink: /blog/
---
<h1 class="page-title">Blog</h1>
<ul class="post-list h-feed">
  {% for post in collections.posts %}
    <li class="post h-entry">
      <h2><a class="p-name u-url" href="{{ post.url }}">{{ post.data.title }}</a></h2>
      <p class="meta"><time class="dt-published" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time></p>
    </li>
  {% endfor %}
</ul>

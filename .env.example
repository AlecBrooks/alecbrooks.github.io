# Copy to .env for local dev if you want to test with these enabled.
# In production these are set as GitHub Actions repo secrets instead.

# Raises the GitHub API rate limit for the Projects pull (60/hr -> 5000/hr).
# In CI this is auto-provided by Actions; locally you'd need a personal
# access token with no special scopes (public read access is enough).
GITHUB_TOKEN=

# From webmention.io after IndieAuth-verifying https://abrooks.dev.
# Leave unset to build the site without webmentions (they just won't show).
WEBMENTION_IO_TOKEN=

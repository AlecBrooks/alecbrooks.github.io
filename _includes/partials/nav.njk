{% set navItems = [
  { url: "/projects/", label: "Projects" },
  { url: "/blog/", label: "Blog" },
  { url: "/contact/", label: "Contact" }
] %}

<nav class="mobile-container">
  <div class="topnav">
    <a href="/" class="site-prompt"><span class="prompt-user">alec@web</span><span class="prompt-sep">:~$</span><span class="prompt-cursor">_</span></a>
    <div id="NavButtons">
      {% for item in navItems %}
        <a href="{{ item.url }}" onclick="CollapseMenu();"{% if page.url == item.url %} class="nav-active"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </div>
    <a href="javascript:void(0);" class="icon" onclick="Hamburger()">
      <i class="fa fa-bars"></i>
    </a>
  </div>
</nav>
<nav class="desktop-container">
  <a href="/" class="site-prompt desktop-only"><span class="prompt-user">alec@web</span><span class="prompt-sep">:~$</span><span class="prompt-cursor">_</span></a>
  <ul id="NavButtons">
    {% for item in navItems %}
      <li><a href="{{ item.url }}"{% if page.url == item.url %} class="nav-active"{% endif %}>{{ item.label }}</a></li>
    {% endfor %}
  </ul>
</nav>
